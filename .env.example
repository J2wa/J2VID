# GEMINI_API_KEY: Required for direct Google Gemini API calls (also accepts GOOGLE_API_KEY or GOOGLE_GENAI_API_KEY).
# On Vercel: Set in Project Settings > Environment Variables as GEMINI_API_KEY.
# In local development: Add to your local .env file.
GEMINI_API_KEY=

# OPENROUTER_API_KEY: Optional API key for OpenRouter (https://openrouter.ai).
# Allows using OpenRouter models or routing requests when Gemini free tier quota is exhausted.
OPENROUTER_API_KEY=

# APP_URL: Optional base URL of the hosted application.
APP_URL=
\n+# Login and live activity (server-side only; never use VITE_ prefixes).
# Set the user/admin passwords privately in Vercel, never in GitHub.
USER_PASSWORD=
ADMIN_PASSWORD=
# Connect an Upstash Redis database. KV_REST_API_URL / KV_REST_API_TOKEN
# are accepted aliases for the following variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
